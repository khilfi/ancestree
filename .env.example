# Copy to .env and fill in. .env is git-ignored: never commit it.
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-a-long-random-password
NEO4J_DATABASE=neo4j

# Photos, stories and documents. Keep this outside OneDrive.
DATA_DIR=C:/dev/ancestree-data

# Where backup archives go: best on another disk than DATA_DIR.
# Leave it out to keep them in DATA_DIR/exports.
BACKUP_DIR=D:/AncesTree-backups
